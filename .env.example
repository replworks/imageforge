PORT=3000
SERVICES=images,avatars,products
IMAGE_HOST=img.repl.net
CF_ZONE_ID=your-zone-id
CF_API_TOKEN=your-cloudflare-api-token
CF_ACCESS_TEAM_DOMAIN=your-team-domain
CF_ACCESS_AUD=your-access-audience
# Local development only. Skips Cloudflare Access verification entirely when set to 1.
# Never set this in a deployed/production environment.
CF_ACCESS_DEV_BYPASS=0
